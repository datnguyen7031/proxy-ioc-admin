PORT=3000
HOST=0.0.0.0

# Upstream server reachable from the machine that is connected to VPN.
UPSTREAM_BASE_URL=http://ioc-admin.toaan.gov.vn/api

# Client-facing API prefix. Requests to /api/... are mapped under UPSTREAM_BASE_URL.
CLIENT_API_PREFIX=/api

# Comma-separated frontend origins. Use * only if the client does not send credentials.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Milliseconds.
PROXY_TIMEOUT_MS=60000

# true = rewrite Host header to upstream host.
CHANGE_ORIGIN=true

# true = log every proxied request.
LOG_REQUESTS=true
