PORT=3000
HOST=0.0.0.0

# Upstream server reachable from the machine that is connected to VPN.
UPSTREAM_BASE_URL=http://dremio.toaan.gov.vn

# Client-facing prefix for IOC Webapp.
# / means the proxy keeps the incoming path as-is.
CLIENT_API_PREFIX=/

# Proxy all IOC Webapp endpoints.
PROXY_ENDPOINTS=/*

# Comma-separated frontend origins. Local/LAN dev origins are also allowed by server.js.
# Use * only if the client does not send credentials.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Milliseconds.
PROXY_TIMEOUT_MS=60000

# true = rewrite Host header to upstream host.
CHANGE_ORIGIN=true

# true = log every proxied request.
LOG_REQUESTS=true
