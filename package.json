{
  "name": "proxy-ioc-admin",
  "version": "1.0.0",
  "description": "Express proxy bridge for IOC Admin APIs that are reachable only from a VPN-connected host.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:ioc-admin": "DOTENV_CONFIG_PATH=.env.ioc-admin node src/server.js",
    "start:ioc-webapp": "DOTENV_CONFIG_PATH=.env.ioc-webapp node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:ioc-admin": "DOTENV_CONFIG_PATH=.env.ioc-admin node --watch src/server.js",
    "dev:ioc-webapp": "DOTENV_CONFIG_PATH=.env.ioc-webapp node --watch src/server.js"
  },
  "keywords": [
    "express",
    "proxy",
    "ioc-admin"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
